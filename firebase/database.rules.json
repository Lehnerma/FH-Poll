{
  "rules": {
    ".read": false,
    ".write": false,
    "poll": {
      ".read": false,
      ".write": false,
      "surveys": {
        ".read": true,
        ".write": "auth != null"
      },
      "responses": {
        "$surveyId": {
          "$nick": {
            ".read": "auth != null",
            ".write": "(!data.exists() && newData.exists()) || auth != null",
            ".validate": "newData.hasChildren(['nickname', 'submittedAt', 'answers'])",
            "nickname": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "submittedAt": {
              ".validate": "newData.val() == now"
            },
            "answers": {
              "$questionId": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "praxis": {
      "archive": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["box"]
      },
      "counters": {
        "archiveId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
        }
      }
    }
  }
}
