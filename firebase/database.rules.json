{
  "rules": {
    ".read": false,
    ".write": false,
    "poll": {
      ".read": false,
      ".write": false
    },
    "praxis": {
      "archive": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["box"]
      },
      "counters": {
        "archiveId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
        }
      }
    }
  }
}
