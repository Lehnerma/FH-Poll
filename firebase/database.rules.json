{
  "rules": {
    ".read": false,
    ".write": false,
    "poll": {
      ".read": false,
      ".write": false,
      "surveys": {
        ".read": true,
        "$surveyId": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || newData.hasChildren(['title', 'active', 'questionCount', 'createdAt'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "questionCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "content": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "responses": {
        ".read": "auth != null",
        "$surveyId": {
          ".write": "auth != null && !newData.exists()"
        }
      }
    },
    "praxis": {
      "archive": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["box"]
      },
      "counters": {
        "archiveId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
        }
      }
    }
  }
}
